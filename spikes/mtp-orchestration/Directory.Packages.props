<Project>

  <!--
    Central Package Management for the MTP orchestration spike. Kept separate from
    src/Directory.Packages.props on purpose: the spike measured Microsoft.Testing.Platform 2.x
    while src/ was still on 1.9.1 under xunit.v3 3.2.2. src/ has since moved to 2.5.1 with
    xunit.v3 4.0.2 (bobcat#470); these pins record what the spike measured and were not moved.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.3.3" />
    <PackageVersion Include="TUnit" Version="1.62.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
