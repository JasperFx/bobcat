<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stands in for Wolverine.ComplianceTests: a LIBRARY of xUnit base classes (xunit.v3.extensibility.core,
    not xunit.v3), consumed by test hosts that subclass it. The generator is referenced HERE because the
    test methods, the step helpers and the marker comments are all in this compilation.
  -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Bobcat.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Bobcat\Bobcat.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat.Xunit\Bobcat.Xunit.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
