<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The service under test in the Aspire sample (bobcat#777): a project resource the AppHost runs
       beside Postgres, so the specs can drive it over HTTP. Never packed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
