<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- NUnit's own Microsoft.Testing.Platform host, so this project is a self-executing test
         application like every other *.Tests project here. -->
    <EnableNUnitRunner>true</EnableNUnitRunner>

    <!-- The interceptor opt-in the Bobcat.Generators PACKAGE carries in buildTransitive; a
         ProjectReference analyzer brings the generator but not its props. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Bobcat.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.NUnit\Bobcat.NUnit.csproj" />
    <!-- So marker comments in Specs/BookingSpecs.cs (docs/nunit.md's example) are declared steps. -->
    <ProjectReference Include="..\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
