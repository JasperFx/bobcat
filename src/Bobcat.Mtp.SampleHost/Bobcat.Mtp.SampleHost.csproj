<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- This IS a test host, but it is driven by Bobcat.Mtp.Tests as an executable rather than
         collected by `dotnet test` itself — otherwise its deliberately-failing scenarios would
         fail the build. -->
    <IsTestProject>false</IsTestProject>

    <!-- A package consumer inherits this from Bobcat.Mtp's buildTransitive props. A
         ProjectReference does not consume another project's build assets, so in-repo it has to
         be set here. Without it the synthesized Main collides with Program.Main (CS0017). -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.Mtp\Bobcat.Mtp.csproj" />
  </ItemGroup>

</Project>
