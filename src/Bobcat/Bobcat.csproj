<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Bobcat runtime — the spec execution engine, resources, rendering, and runner for the spec-driven integration testing framework for .NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JasperFx" />
    <!-- JasperFx.Events 2.56.0 — IEventModelDefinitionSource, which the generator's emitted
         BobcatEventModelSource implements, moved out of the JasperFx package and into this one.
         Bobcat carries the reference so it flows transitively to every project the generator
         emits into; without it that generated file does not compile in a consumer. -->
    <PackageReference Include="JasperFx.Events" />
  </ItemGroup>

  <!--
    The arrangement-reference step (issue #259) ships AS SOURCE too, for the editors: VS Code's
    Cucumber extension parses step definitions from source only, so without this every
    `Given the arrangement "…"` in a consumer's feature is underlined as undefined. The generator
    never needs it (it expands references itself). buildAction=None keeps it out of the consumer's
    compilation — same arrangement as Bobcat.CritterStack's shipped grammar; see
    docs/editor-integration.md.
  -->
  <ItemGroup>
    <Content Include="ArrangementSteps.cs">
      <Pack>true</Pack>
      <PackagePath>contentFiles/cs/any/Bobcat/</PackagePath>
      <BuildAction>None</BuildAction>
      <PackageCopyToOutput>false</PackageCopyToOutput>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="ArrangementSteps.cs">
      <Pack>true</Pack>
      <PackagePath>content/grammars/</PackagePath>
      <BuildAction>None</BuildAction>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
