<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Bobcat runtime — the projected specification engine, verification, rendering, the monitor wire, the resident runner and the resilience vocabulary for the spec-driven integration testing framework for .NET. Takes no JasperFx or Wolverine dependency; the Critter Stack vocabulary ships in WolverineFx.Bobcat.</Description>
  </PropertyGroup>

  <!--
    No JasperFx and no Wolverine, by design (bobcat#744): a test framework must not pin its users'
    application framework. These three came transitively through JasperFx until then.
    BobcatAssemblyReferenceTests guards it.
  -->
  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <!--
    The results file's JSON Schema (issue #540) is generated, not committed (bobcat#604):
    ResultsFile.GenerateSchema writes it beside every results file at run time, and the Nuke Pack
    target writes it to artifacts/schemas (`bobcat results-schema`) before packing, so the package
    still carries it under schemas/. A pack that skipped that step would ship without it, silently,
    so it is an error instead.
  -->
  <PropertyGroup>
    <ResultsSchemaDirectory Condition="'$(ResultsSchemaDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\schemas\</ResultsSchemaDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ResultsSchemaDirectory)bobcat-results-*.schema.json" Pack="true" PackagePath="schemas" Visible="false" />
  </ItemGroup>

  <Target Name="RequireResultsSchema" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ResultsSchemaToPack Include="$(ResultsSchemaDirectory)bobcat-results-*.schema.json" />
    </ItemGroup>
    <Error Condition="'@(_ResultsSchemaToPack)' == ''"
           Text="No results schema in $(ResultsSchemaDirectory) to pack under schemas/. Pack through `./build.sh Pack`, which generates it (bobcat#604)." />
  </Target>

</Project>
