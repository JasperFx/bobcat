<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Bobcat runtime — the projected specification engine, verification, rendering, the monitor wire, and the store-agnostic Critter Stack vocabulary (bound to JasperFx.Events, so they serve Marten, Polecat and Fisher alike) for the spec-driven integration testing framework for .NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JasperFx" />
    <!-- JasperFx.Events 2.56.0 — IEventModelDefinitionSource, which the generator's emitted
         BobcatEventModelSource implements, moved out of the JasperFx package and into this one.
         Bobcat carries the reference so it flows transitively to every project the generator
         emits into; without it that generated file does not compile in a consumer. -->
    <PackageReference Include="JasperFx.Events" />
  </ItemGroup>

  <!--
    The results file's JSON Schema (issue #540) is generated, not committed (bobcat#604):
    ResultsFile.GenerateSchema writes it beside every results file at run time, and the Nuke Pack
    target writes it to artifacts/schemas (`bobcat results-schema`) before packing, so the package
    still carries it under schemas/. A pack that skipped that step would ship without it, silently,
    so it is an error instead.
  -->
  <PropertyGroup>
    <ResultsSchemaDirectory Condition="'$(ResultsSchemaDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\schemas\</ResultsSchemaDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ResultsSchemaDirectory)bobcat-results-*.schema.json" Pack="true" PackagePath="schemas" Visible="false" />
  </ItemGroup>

  <Target Name="RequireResultsSchema" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ResultsSchemaToPack Include="$(ResultsSchemaDirectory)bobcat-results-*.schema.json" />
    </ItemGroup>
    <Error Condition="'@(_ResultsSchemaToPack)' == ''"
           Text="No results schema in $(ResultsSchemaDirectory) to pack under schemas/. Pack through `./build.sh Pack`, which generates it (bobcat#604)." />
  </Target>

</Project>
