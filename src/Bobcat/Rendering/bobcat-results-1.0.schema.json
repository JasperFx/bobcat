{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bobcat results file",
  "description": "One Bobcat run's specifications and their results. Schema version 1.0.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The schema this file conforms to, written beside it.",
      "type": "string"
    },
    "schemaVersion": {
      "description": "The version of this file's shape.",
      "type": "string"
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": {
          "description": "The run's id: the one on run_started, BOBCAT_RUN_ID when set.",
          "type": "string",
          "format": "uuid"
        },
        "suite": {
          "description": "The spec assembly.",
          "type": "string"
        },
        "mode": {
          "description": "How it ran: xunit, tunit, nunit, mstest.",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "description": "BOBCAT_RUN_TAG, verbatim.",
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "description": "The resident runner command that asked for the run.",
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer"
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "scenarios": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "acceptanceFailing": {
          "description": "Acceptance specifications that are not yet passing (verdict \"acceptance: failing\"): counted in neither passed nor failed, and never the reason succeeded is false.",
          "type": "integer"
        },
        "succeeded": {
          "description": "True when no scenario in the file failed the run: every one passed, or is an Acceptance specification not yet passing.",
          "type": "boolean"
        },
        "rights": {
          "type": "integer"
        },
        "wrongs": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        }
      }
    },
    "scenarios": {
      "description": "Every scenario the run finished, by feature then title. A skipped test is not here; a failing Acceptance specification, which the test platform reports skipped, is, with its verdict.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reports": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "shortTitle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "suppressedRows": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "grid": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "row": {
                            "type": "integer"
                          },
                          "type": {
                            "type": "string"
                          },
                          "cells": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "object",
                              "properties": {
                                "column": {
                                  "type": "string"
                                },
                                "row": {
                                  "type": [
                                    "integer",
                                    "null"
                                  ]
                                },
                                "status": {
                                  "type": "string"
                                },
                                "expected": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "actual": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "note": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "value": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                }
                              }
                            }
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "feature": {
            "type": [
              "string",
              "null"
            ]
          },
          "succeeded": {
            "type": "boolean"
          },
          "verdict": {
            "description": "passed, failed, \"acceptance: failing\" or \"acceptance: passing\". A failing Acceptance specification keeps succeeded false and every step and cell, and does not fail the run.",
            "type": "string"
          },
          "specLifecycle": {
            "description": "\"acceptance\" for an Acceptance specification; absent for the default, Regression.",
            "type": [
              "string",
              "null"
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "rights": {
                "type": "integer"
              },
              "wrongs": {
                "type": "integer"
              },
              "errors": {
                "type": "integer"
              },
              "succeeded": {
                "type": "boolean"
              }
            }
          },
          "durationMs": {
            "type": "integer"
          },
          "stepsMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lifecycle": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "startedAtMs": {
                  "type": "integer"
                },
                "durationMs": {
                  "type": "integer"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stepId": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "keyword": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "depth": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "narrative": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "notRun": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "failureLevel": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "startedAtMs": {
                  "type": "integer"
                },
                "durationMs": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "exceptionType": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "logs": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "suppressedLogs": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "diagnostics": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "cells": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "$ref": "#/properties/scenarios/items/properties/reports/items/properties/grid/properties/rows/items/properties/cells/items"
                  }
                },
                "setVerification": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "columns": {
                      "$ref": "#/properties/scenarios/items/properties/reports/items/properties/grid/properties/columns"
                    },
                    "rows": {
                      "$ref": "#/properties/scenarios/items/properties/reports/items/properties/grid/properties/rows"
                    }
                  }
                }
              }
            }
          },
          "scenarioFailure": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenarioFailureCells": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/properties/scenarios/items/properties/reports/items/properties/grid/properties/rows/items/properties/cells/items"
            }
          },
          "logs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "suppressedLogs": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "timing": {
      "description": "Where the run spent its time; absent when nothing was measured.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "measuredMs": {
          "type": "integer"
        },
        "unmeasured": {
          "type": [
            "integer",
            "null"
          ]
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "wallClockMs": {
                "type": "integer"
              },
              "stepsMs": {
                "type": "integer"
              },
              "lifecycleMs": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "unownedMs": {
                "type": "integer"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "occurrences": {
                "type": "integer"
              },
              "totalMs": {
                "type": "integer"
              },
              "maxMs": {
                "type": "integer"
              }
            }
          }
        },
        "lifecycle": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/properties/timing/properties/steps/items"
          }
        },
        "lifecycleMeasured": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "gaps": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "feature": {
                "type": "string"
              },
              "scenario": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "durationMs": {
                "type": "integer"
              }
            }
          }
        },
        "withoutAssertions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
