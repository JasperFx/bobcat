<Project>

  <!--
    Shared MSBuild properties for the Bobcat source tree (src/).

    The released NuGet version is centralized here: bump <Version> to release a new version
    of every Bobcat.* library together. Projects are non-packable by default; each library
    that ships as a NuGet opts in with <IsPackable>true</IsPackable>.
  -->
  <PropertyGroup>
    <Version>1.0.0-alpha.1</Version>

    <Authors>Jeremy D. Miller</Authors>
    <Company>JasperFx Software</Company>
    <Product>Bobcat</Product>
    <PackageProjectUrl>https://github.com/JasperFx/bobcat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JasperFx/bobcat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      The repository's own LICENSE (MIT) travels in every package, packed from the root below.
      NuGet will not take this and <PackageLicenseExpression> together (NU5033).
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>testing;integration-testing;bdd;specification;critterstack</PackageTags>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Released libraries opt back in individually. -->
    <IsPackable>false</IsPackable>

    <!--
      Each shipped library also sets <GenerateDocumentationFile>, so its Bobcat.xml travels beside
      the dll and a consumer gets IntelliSense for the vocabulary (bobcat#622). That cannot be set
      here on IsPackable: this file is read before the project sets it (see the icon below).
      Three of the warnings it turns on are noise rather than defects, and are off everywhere —
      harmless where no documentation file is generated, because none of them fire there:
        CS1591  a public member with no comment. Much of the public surface is self-describing.
        CS1573  a parameter with no <param> beside one that has it. The prose usually covers it.
        CS0419  a cref naming an overloaded method. It still resolves (to one overload) for a reader.
      The rest — a cref or param tag naming nothing — stay warnings, because they are wrong.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
  </PropertyGroup>

  <!--
    The lynx mark every Bobcat package wears on nuget.org — src/icon.png, a 256px downscale of
    the docs site's own avatar (docs/public/bobcat-avatar-dark-512.png), copied rather than
    referenced across the tree for the same reason the SPA copies it: a package's content has to
    live where its build can see it, and a path out of src/ is one more thing that can rot.

    Unconditional on purpose. <PackageIcon> names a file NuGet expects to find PACKED, so a
    packable project without the item errors with NU5046 — and the obvious condition,
    '$(IsPackable)' == 'true', would be wrong here: this file is imported at the top of every
    csproj, before the project sets IsPackable, so it would read the false above for everyone
    and pack nothing anywhere. A None item in a project that never packs costs nothing.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />

    <!--
      Referenced where it lives rather than copied into src/ like the icon: the root LICENSE is
      the one GitHub and every reader sees, and two copies of a license can only drift. Same
      unconditional reasoning as the icon — <PackageLicenseFile> errors (NU5030) in any packable
      project that does not pack the file.
    -->
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Test projects run on Microsoft.Testing.Platform rather than VSTest. xUnit v3 ships as an MTP
    test host, so each *.Tests project compiles to a self-executing test application. Applied
    here rather than per-project so a new test project cannot silently fall back to VSTest and
    diverge from the rest.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- A v3 test project IS the test host, so it has to be executable. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

</Project>
