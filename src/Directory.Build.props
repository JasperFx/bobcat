<Project>

  <!--
    Shared MSBuild properties for the Bobcat source tree (src/).

    The released NuGet version is centralized here: bump <Version> to release a new version
    of every Bobcat.* library together. Projects are non-packable by default; each library
    that ships as a NuGet opts in with <IsPackable>true</IsPackable>.
  -->
  <PropertyGroup>
    <Version>0.16.0</Version>

    <Authors>Jeremy D. Miller</Authors>
    <Company>JasperFx Software</Company>
    <Product>Bobcat</Product>
    <PackageProjectUrl>https://github.com/JasperFx/bobcat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JasperFx/bobcat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>testing;integration-testing;bdd;gherkin;specification;critterstack</PackageTags>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Released libraries opt back in individually. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The lynx mark every Bobcat package wears on nuget.org — src/icon.png, a 256px downscale of
    the docs site's own avatar (docs/public/bobcat-avatar-dark-512.png), copied rather than
    referenced across the tree for the same reason the SPA copies it: a package's content has to
    live where its build can see it, and a path out of src/ is one more thing that can rot.

    Unconditional on purpose. <PackageIcon> names a file NuGet expects to find PACKED, so a
    packable project without the item errors with NU5046 — and the obvious condition,
    '$(IsPackable)' == 'true', would be wrong here: this file is imported at the top of every
    csproj, before the project sets IsPackable, so it would read the false above for everyone
    and pack nothing anywhere. A None item in a project that never packs costs nothing.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Test projects run on Microsoft.Testing.Platform rather than VSTest. xUnit v3 ships as an MTP
    test host, so each *.Tests project compiles to a self-executing test application. Applied
    here rather than per-project so a new test project cannot silently fall back to VSTest and
    diverge from the rest.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- A v3 test project IS the test host, so it has to be executable. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

</Project>
