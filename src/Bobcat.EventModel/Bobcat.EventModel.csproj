<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Declared Event Model files for the Critter Stack — a curated YAML format that loads as a Declared-rung IEventModelDefinitionSource, plus an importer for eventmodelers.ai emlang board exports.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced directly, not transitively: Central Package Management only pins what a
         project actually references, and an older transitive JasperFx.Events resolves to the
         pre-#687 EventModeling sketch that compiles and then silently drops pattern /
         specifications / elements. -->
    <PackageReference Include="JasperFx.Events" />
    <PackageReference Include="YamlDotNet" />
    <!-- The additive re-import (ImportMerge) parses the files an earlier import wrote, and the user
         has since edited, to find where an addition goes: the end of a definition's Configure, of a
         stub's namespace, of a spec class. A regex over C# breaks on the first reformat. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
