<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <!--
      The TESTS reference Marten and Fisher, to prove the store-agnostic binding against two real
      stores: Marten on the repo's Postgres (5445, skipped when absent) and Fisher on a temp SQLite
      file (no docker, never skipped). Bobcat.CritterStack itself references neither — that is the
      point of the tests. Polecat needs SQL Server and is the documented manual path.
    -->
    <PackageReference Include="Marten" />
    <PackageReference Include="Fisher" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <!-- Marten 9.30.0 and Fisher 1.0.4 each bundle JasperFx.Events.SourceGenerator inside their
         own nupkg, so referencing both loads the generator twice and every projection's Evolver
         partial is emitted twice (CS0433 — jasperfx#462). Compile with the explicit, centrally
         pinned generator instead; the target below drops every store-bundled copy. -->
    <PackageReference Include="JasperFx.Events.SourceGenerator"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="DropDuplicateBundledEventSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'JasperFx.Events.SourceGenerator' and ($([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/marten/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/fisher/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/polecat/')))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.CritterStack\Bobcat.CritterStack.csproj" />
    <!-- The shipped grammar is compiled from a .feature file, so this project runs the generator to
         prove the #104 acceptance: a feature written only in grammar steps compiles and runs. -->
    <ProjectReference Include="..\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Features\**\*.feature" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same database, same skip rule as the Marten tests: shared rather than copied. -->
    <Compile Include="..\Bobcat.Marten.Tests\PostgresEnvironment.cs" Link="PostgresEnvironment.cs" />
  </ItemGroup>

</Project>
