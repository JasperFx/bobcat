<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <!--
      The TESTS reference Marten and Fisher, to prove the store-agnostic binding against two real
      stores: Marten on the repo's Postgres (5445, skipped when absent) and Fisher on a temp SQLite
      file (no docker, never skipped). Bobcat.CritterStack itself references neither — that is the
      point of the tests. Polecat needs SQL Server and is the documented manual path.
    -->
    <PackageReference Include="Marten" />
    <PackageReference Include="Fisher" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.CritterStack\Bobcat.CritterStack.csproj" />
    <!-- The shipped grammar is compiled from a .feature file, so this project runs the generator to
         prove the #104 acceptance: a feature written only in grammar steps compiles and runs. -->
    <ProjectReference Include="..\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Features\**\*.feature" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same database, same skip rule as the Marten tests: shared rather than copied. -->
    <Compile Include="..\Bobcat.Marten.Tests\PostgresEnvironment.cs" Link="PostgresEnvironment.cs" />
  </ItemGroup>

</Project>
