<Project>

  <!--
    Flows to any project that references the Bobcat.Mtp package.

    Microsoft.Testing.Platform.MSBuild normally synthesizes a Main for the test host. Bobcat spec
    projects write their own — `BobcatTestApplication.Run(args, ...)` is how features and
    resources get registered — so the generated one would be a second entry point and the build
    fails with CS0017. Turning it off here means a consumer never has to discover that.
  -->
  <PropertyGroup>
    <GenerateTestingPlatformEntryPoint Condition="'$(GenerateTestingPlatformEntryPoint)' == ''">false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <!--
    Bobcat.Generators emits the host's Main itself when the project declares none (issue #207).
    Surfacing this property to the analyzer lets `<BobcatGenerateEntryPoint>false</BobcatGenerateEntryPoint>`
    opt a project out of the generated entry point. A ProjectReference does not consume these
    props, so in-repo projects that want the opt-out must declare the CompilerVisibleProperty
    themselves.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="BobcatGenerateEntryPoint" />
  </ItemGroup>

</Project>
