<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>
      Runs Bobcat specifications as a Microsoft.Testing.Platform test host, so `dotnet test`,
      IDE Test Explorers and CI treat Bobcat features like any other test project.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept out of core Bobcat deliberately: consumers who never want an MTP host should not
         inherit the platform dependency. -->
    <PackageReference Include="Microsoft.Testing.Platform" />

    <!-- Supplies `dotnet test` support and the ProjectCapability that Visual Studio / VS Code
         Test Explorers look for. Without it a Bobcat host is only runnable as a bare executable. -->
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships in the nupkg so consumers inherit the entry-point setting. See the file. -->
    <None Include="buildTransitive\Bobcat.Mtp.props" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
