<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <IsPackable>true</IsPackable>
    <Description>Bobcat source generator — compiles .feature files into direct fixture method calls at build time (no runtime reflection). Reference as an analyzer.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Source generators ship the analyzer assembly only, with no lib/ output or deps. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Pack the generator into the analyzer path so consumers pick it up via PackageReference. -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!--
      buildTransitive, not build. A package's build/ assets are private to the project that
      references it (NuGet's default PrivateAssets includes `build`), and this generator reaches
      further than that: an analyzer DOES flow across a ProjectReference, so a project that merely
      references a marked-up test project gets generated interceptors it never asked for — and,
      under build/, no opt-in to compile them with. That asymmetry is exactly what broke Marten's
      DaemonTests.ManualOnly, and shipping the props under build/ in 0.17.0 did not fix it.

      Verified with a two-project probe: buildTransitive/ props reach the direct referencer AND the
      transitive one; build/ props reach neither once buildTransitive exists, so there is no reason
      to ship both.
    -->
    <None Include="buildTransitive\Bobcat.Generators.props" Pack="true" PackagePath="buildTransitive" Visible="false" />
  </ItemGroup>


  <ItemGroup>
    <!-- The marker-comment parser (issue #110) is a heuristic over comment text, and its risk is
         reading too much: an ordinary explanatory comment must not become a step. That is worth
         unit tests against the parser rather than only end-to-end through the harness. -->
    <InternalsVisibleTo Include="Bobcat.Generators.Tests" />
  </ItemGroup>
</Project>
