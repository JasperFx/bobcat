<Project Sdk="Microsoft.NET.Sdk">

  <!--
    bobcat#471: CritterStackScenario, the store-only projected vocabulary, against two real stores with NO
    message bus registered — Marten on the repo's Postgres (5445, [PostgresFact], skipped locally when
    absent and never on CI) and Fisher on a temp SQLite file (never skipped). There is deliberately no
    Wolverine reference anywhere in this project: a pass proves the vocabulary needs none.

    A new project rather than a home in Bobcat.CritterStack.Tests, which goes with the Gherkin lane in
    phase 3 of bobcat#471.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Fisher" />
    <!-- Marten and Fisher each bundle JasperFx.Events.SourceGenerator in their own nupkg, so referencing
         both loads the generator twice (CS0433 — jasperfx#462). Compile with the explicit, centrally pinned
         generator instead; the target below drops every store-bundled copy. Same as
         Bobcat.CritterStack.Tests. -->
    <PackageReference Include="JasperFx.Events.SourceGenerator"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="DropDuplicateBundledEventSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'JasperFx.Events.SourceGenerator' and ($([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/marten/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/fisher/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/polecat/')))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
  </ItemGroup>

</Project>
