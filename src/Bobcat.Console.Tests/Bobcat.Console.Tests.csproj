<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!--
    The one place both sides of the monitor wire meet: Bobcat's dependency-free publisher
    mirrors and Bobcat.Console's Wolverine-marked ingestion contracts. The round-trip tests
    here are what let the two record sets stay deliberately unshared.
  -->
  <ItemGroup>
    <!-- The supervisor tests' hand-rolled clock, linked rather than duplicated: the idle-shutdown
         ceiling (issue #200) needs exactly the same "advance time by hand" facility, and a second
         copy is a second thing to keep correct. Same pattern as the agreement tests' linked
         sources. -->
    <Compile Include="..\Bobcat.Supervisor.Tests\FakeTimeProvider.cs" Link="FakeTimeProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
    <ProjectReference Include="..\Bobcat.Console\Bobcat.Console.csproj" />
    <!--
      Issue #294. This project is the only one in the tree that can see BOTH ends of the sentence
      "a spec assembly's Event Model half reaches the console and comes back in the merge": it
      references Bobcat (so a real BobcatRunner can publish) and Bobcat.Console (so a real
      EventModelStore can do the merging). Running the generator here gives it the third piece —
      a real generated BobcatEventModelSource, from Features/Wallet.feature — so nothing in
      SpecEventModelPublishingTests is a stand-in for the artefact under test.
    -->
    <ProjectReference Include="..\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Features\**\*.feature" />
  </ItemGroup>

</Project>
