<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!--
    The one place both sides of the monitor wire meet: Bobcat's dependency-free publisher
    mirrors and Bobcat.Console's Wolverine-marked ingestion contracts. The round-trip tests
    here are what let the two record sets stay deliberately unshared.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
    <ProjectReference Include="..\Bobcat.Console\Bobcat.Console.csproj" />
  </ItemGroup>

</Project>
