<Project>

  <!--
    Central Package Management for the Bobcat source tree (src/). One pinned version per
    package so the Bobcat.* projects can never drift apart.

    Since bobcat#744 the runtime packages a consumer restores (Bobcat, Bobcat.Supervisor once #745
    lands, the runner adapters, Bobcat.Generators) take NO JasperFx or Wolverine dependency, so
    nothing below decides what a consumer's Critter Stack resolves to. JasperFx and JasperFx.Events
    are pinned for the tools and their tests only: Bobcat.EventModel (the board import writes
    JasperFx.Events' fluent EventModelDefinition), the `bobcat` tool, and Bobcat.Ui, which also
    keeps its WolverineFx.Http / SignalR / RuntimeCompilation host. The Critter Stack alignment
    notes and the store pins (Marten, Fisher, Polecat, WolverineFx.Marten/Fisher, the bundled
    JasperFx.Events.SourceGenerator) left with the vocabulary, its tests and the samples for the
    Wolverine repo; git history before #744 has them.

    The Spectre.Console and Microsoft.Extensions.*.Abstractions pins are core's own references,
    which it used to receive transitively through JasperFx. They are held at the lowest version
    that serves both target frameworks, because a test framework's floor becomes every
    consumer's floor.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tools only (Bobcat.EventModel, Bobcat.Console, Bobcat.Ui) and the tests that drive them: see the header. -->
    <PackageVersion Include="JasperFx" Version="2.90.2" />
    <PackageVersion Include="JasperFx.Events" Version="2.90.2" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.46.0" />

    <!-- Core's own references, received transitively through JasperFx before bobcat#744. -->
    <PackageVersion Include="Spectre.Console" Version="0.55.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <!-- Bobcat.Supervisor.ProjectedWorker only (a test host): its connection-string probe. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />

    <PackageVersion Include="Alba" Version="8.5.2" />
    <!-- Bobcat.Tests only. AlbaContentRoot reads [WebApplicationFactoryContentRoot] reflectively
         by type name so the shipped package needs no ASP.NET reference; the test assembly carries
         the real attribute so the reflective read is proved against the real type. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />

    <!-- Bobcat.Ui's host (bobcat#744 leaves the UI its Wolverine coupling: it is a tool). -->
    <PackageVersion Include="WolverineFx.Http" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.SignalR" Version="6.46.0" />
        <!--
      TypeScript contract codegen for the monitor's Vue SPA (CritterWatch's GenerateCommand
      pattern): NJsonSchema reflects the MonitorEvents.cs records through the same STJ settings
      the wire uses, so the .ts mirrors can only ever say what the serializer does.
    -->
    <PackageVersion Include="NJsonSchema" Version="11.5.2" />
    <PackageVersion Include="NJsonSchema.CodeGeneration.TypeScript" Version="11.5.2" />
    <!--
      Consumed by Bobcat.EventModel: the curated YAML event-model loader and the emlang importer
      (#201/#202), which the `bobcat` CLI exposes as import-event-model.
    -->
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />

    <!--
      Microsoft.Testing.Platform (Bobcat.Xunit's platform extension, and the MTP orchestration spike).

      2.5.1 because that is exactly what xunit.v3 4.0.2 builds against (its runner package is
      xunit.v3.core.mtp-v2, which requires Microsoft.Testing.Platform 2.5.1), and TUnit.Engine 1.74.0
      requires the same 2.5.1, so an xUnit suite and a TUnit suite can share one platform. This pin
      was 1.9.1 until bobcat#470: xunit.v3 3.x ships against MTP 1.x (xunit.v3.core.mtp-v1), and
      forcing 2.x under it dies with a TypeLoadException on IDataConsumer. The platform and xUnit
      therefore move TOGETHER — never bump this alone, and never put a 3.x xunit.v3 beside it.

      Two consequences of 2.x worth knowing before touching anything here:
      * MTP 2.x refuses the VSTest bridge on the .NET 10 SDK, so the root global.json opts
        `dotnet test` into its MTP mode. That mode takes the solution or project as an option rather than a
        positional path, and collects every project whose IsTestingPlatformApplication is true —
        IsTestProject=false no longer opts a host out (see Bobcat.Xunit.Samples).
      * Bobcat.NUnit.Tests and Bobcat.MSTest.Tests still run on MTP 1.9.x through their adapters
        (below); they reference no Bobcat.Xunit, so nothing forces this 2.5.1 onto them.
    -->
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.1" />

    <!-- Roslyn (source generator only) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />

    <!--
      Test stack. xUnit v3 ships as a Microsoft.Testing.Platform test host, so the test projects
      are self-executing MTP applications rather than VSTest assemblies. That means no
      Microsoft.NET.Test.Sdk, no xunit.runner.visualstudio, and no coverlet.collector (a VSTest
      data collector) — MTP supplies its own equivalents.

      This also lets Bobcat's own specs run beside these projects under one runner, which is the
      point of the MTP work in issue #41.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!--
      Runner adapters (Bobcat.Xunit, Bobcat.TUnit — issue #110). Each takes the smallest piece of
      its runner that an adapter can be written against: xunit.v3.extensibility.core is what
      xunit.v3 itself layers the runner and assertions on top of, and TUnit.Core is TUnit's
      equivalent. A consumer already has the full package; an adapter that dragged it in would be
      pinning that consumer's runner version from underneath.

      xunit.v3.extensibility.core moves in lockstep with xunit.v3 above and must stay equal to it.
    -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="TUnit.Core" Version="1.74.0" />
    <!-- Bobcat.TUnit.Tests only (bobcat#470): a real TUnit host. Same version as TUnit.Core above. -->
    <PackageVersion Include="TUnit" Version="1.74.0" />
    <!--
      Bobcat.NUnit (issue #385) takes the NUnit framework package only, which depends on no test
      platform, so it is safe to ship beside whatever platform the pin above names. Bobcat.MSTest (issue #386) takes
      no MSTest package at all — its csproj says why — so MSTest.* here is for its test project.

      Their RUNNERS are another matter, and only the test projects take them. Each is held at its
      last release built against Microsoft.Testing.Platform 1.9.x: NUnit3TestAdapter 5.2.0 (6.0
      moves to MTP 2.x) and MSTest.TestAdapter 3.11.1 (4.0 moves to MTP 2.x). They were held there
      to match the old 1.9.1 platform pin. Each test project resolves its own platform through its
      adapter, so they still run on 1.9.x beside src's 2.5.1; moving them to NUnit3TestAdapter 6.x /
      MSTest 4.x is now possible but untried (bobcat#470 left them alone). The framework and its
      adapter move together, so MSTest.TestFramework stays equal to MSTest.TestAdapter.
    -->
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.11.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- Only the F# shape fixtures for the partial-object tests (bobcat#417); nothing shipped references it. -->
    <PackageVersion Include="FSharp.Core" Version="9.0.303" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

</Project>
