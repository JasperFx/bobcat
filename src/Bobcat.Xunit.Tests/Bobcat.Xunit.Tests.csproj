<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform-extension registration the Bobcat.Xunit PACKAGE carries in buildTransitive;
         a ProjectReference does not consume another project's build assets, so in-repo it is
         stated here. Without it MarkerStepRun's run bracket falls back to per-process, which is
         issue #402's whole subject. -->
    <TestingPlatformBuilderHook Include="0A1C4D7E-3B52-4F8A-9C61-7D2E8B4A5F30">
      <DisplayName>Bobcat.Xunit</DisplayName>
      <TypeFullName>Bobcat.Xunit.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>

    <!-- Likewise the package's [BobcatFeature]-records-on-its-own hook. -->
    <AssemblyAttribute Include="Bobcat.Xunit.RecordBobcatFeaturesAttribute" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.Xunit\Bobcat.Xunit.csproj" />
    <!--
      The TUnit adapter is verified from here rather than from a TUnit test project, and that is a
      constraint rather than a shortcut. TUnit.Engine depends on Microsoft.Testing.Platform 2.4.0;
      this repo pins 1.9.1 because that is what xunit.v3 3.2.2 builds against, and CLAUDE.md
      records what moving it costs (a TypeLoadException on IDataConsumer from xUnit's own MSBuild
      extension). Bobcat.TUnit itself references only TUnit.Core, which depends on no test platform
      at all — so the package is safe to ship and safe to reference here, and only a TUnit *runner*
      would collide.
    -->
    <ProjectReference Include="..\Bobcat.TUnit\Bobcat.TUnit.csproj" />
  </ItemGroup>

</Project>
