<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Bobcat + Wolverine — the act. Dispatches a message through Wolverine's tracked session so a spec's assertions run after everything the message caused has settled.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bobcat.Wolverine.Tests" />
  </ItemGroup>

</Project>
