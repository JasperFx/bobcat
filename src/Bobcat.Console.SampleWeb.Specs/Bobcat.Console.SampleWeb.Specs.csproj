<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The common spec-project layout bobcat#797 is about: a spec suite that references the executable
    application it tests, so its build output folder holds two executables (this test host and
    Bobcat.Console.SampleWeb). Bobcat.Console.Tests points `bobcat resident` at that folder and
    expects this host to be the one it picks.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- A self-executing xUnit v3 / MTP application, stated here because the name does not end in
         .Tests. Driven by Bobcat.Console.Tests, never collected by `dotnet test`; see
         Bobcat.Supervisor.ProjectedWorker for why each of these is needed on MTP 2.x. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateTestingPlatformConfigurationFile>true</GenerateTestingPlatformConfigurationFile>
    <GenerateSelfRegisteredExtensions>true</GenerateSelfRegisteredExtensions>

    <!-- The interceptor opt-in the Bobcat.Generators PACKAGE carries in buildTransitive. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Bobcat.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform-extension registration the Bobcat.Xunit PACKAGE carries in buildTransitive;
         a ProjectReference does not consume another project's build assets. -->
    <TestingPlatformBuilderHook Include="0A1C4D7E-3B52-4F8A-9C61-7D2E8B4A5F30">
      <DisplayName>Bobcat.Xunit</DisplayName>
      <TypeFullName>Bobcat.Xunit.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.Console.SampleWeb\Bobcat.Console.SampleWeb.csproj" />
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
    <ProjectReference Include="..\Bobcat.Xunit\Bobcat.Xunit.csproj" />
    <ProjectReference Include="..\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
