<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- A self-executing xUnit v3 / MTP application, stated here because the name does not end in
         .Tests (see Bobcat.Xunit.Samples for why TestingPlatformDotnetTestSupport is NOT set). -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- Driven by Bobcat.Supervisor.Tests as a worker process, never collected by `dotnet test` —
         its specifications fail, hang and crash on purpose. -->
    <IsTestProject>false</IsTestProject>

    <!--
      IsTestProject=false is no longer enough on MTP 2.x: `dotnet test` in its MTP mode (global.json)
      collects every project whose IsTestingPlatformApplication is true and ignores IsTestProject.
      Turning that off also turns off the defaults it drives, so the three this host still needs —
      the platform config file and the self-registered extensions (Bobcat's session hook) — are
      restated. xUnit generates its own entry point either way.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateTestingPlatformConfigurationFile>true</GenerateTestingPlatformConfigurationFile>
    <GenerateSelfRegisteredExtensions>true</GenerateSelfRegisteredExtensions>

    <!-- The interceptor opt-in the Bobcat.Generators PACKAGE carries in buildTransitive. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Bobcat.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform-extension registration the Bobcat.Xunit PACKAGE carries in buildTransitive;
         a ProjectReference does not consume another project's build assets. -->
    <TestingPlatformBuilderHook Include="0A1C4D7E-3B52-4F8A-9C61-7D2E8B4A5F30">
      <DisplayName>Bobcat.Xunit</DisplayName>
      <TypeFullName>Bobcat.Xunit.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Probes.cs reads connection strings through IConfiguration (issue #414). Core brought this
         transitively through JasperFx until bobcat#744. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
    <ProjectReference Include="..\Bobcat.Xunit\Bobcat.Xunit.csproj" />
    <ProjectReference Include="..\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
