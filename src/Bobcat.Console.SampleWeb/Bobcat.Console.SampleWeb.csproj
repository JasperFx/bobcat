<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    An executable web app that a spec project references (bobcat#797), so that the spec project's
    build output holds two executables: this one and the test host. Bobcat.Console.Tests points
    `bobcat resident` at that folder. Never run, never packed.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
