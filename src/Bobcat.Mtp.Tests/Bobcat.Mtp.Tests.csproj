<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.Mtp\Bobcat.Mtp.csproj" />

    <!-- Build ordering only. The sample host is launched as an executable, not linked — its
         Main would otherwise collide with the test host's entry point. -->
    <ProjectReference Include="..\Bobcat.Mtp.SampleHost\Bobcat.Mtp.SampleHost.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
