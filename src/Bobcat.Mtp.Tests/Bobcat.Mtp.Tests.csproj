<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!-- One source, two compilations — the same arrangement SliceTagParsingAgreementTests uses.
         The resident runner (issue #390) is driven against the real HTTP stand-in for a console,
         and that stand-in already exists; a second copy would be a second thing to keep correct,
         and its port-binding and double-dispose notes were both paid for once already. -->
    <Compile Include="..\Bobcat.Tests\Monitoring\FakeMonitorHost.cs"
             Link="Monitoring\FakeMonitorHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.Mtp\Bobcat.Mtp.csproj" />

    <!-- Build ordering only. The sample host is launched as an executable, not linked — its
         Main would otherwise collide with the test host's entry point. -->
    <ProjectReference Include="..\Bobcat.Mtp.SampleHost\Bobcat.Mtp.SampleHost.csproj"
                      ReferenceOutputAssembly="false" />

    <!-- Same arrangement for the issue #207 proof project: launched as an executable, its
         generator-emitted Main would otherwise collide with this test host's entry point. -->
    <ProjectReference Include="..\Bobcat.Mtp.GeneratedHost\Bobcat.Mtp.GeneratedHost.csproj"
                      ReferenceOutputAssembly="false" />

    <!-- The projected lane's half of the issue #391 corpus. Both lanes are pinned from one test
         class so they cannot drift apart, and this is the project that already launches a test
         host as a real process. Build ordering only, like the two above: its tests fail on
         purpose, and only named specifications are ever run from here. -->
    <ProjectReference Include="..\Bobcat.Xunit.Samples\Bobcat.Xunit.Samples.csproj"
                      ReferenceOutputAssembly="false" />

    <!-- Issue #398's subject: a Gherkin host whose Main is BobcatRunner.Run, with no reference to
         Bobcat.Mtp. Build ordering only, like the three above — it is launched as an executable. -->
    <ProjectReference Include="..\ConsolePreview\ConsolePreview.csproj"
                      ReferenceOutputAssembly="false" />

  </ItemGroup>

</Project>
