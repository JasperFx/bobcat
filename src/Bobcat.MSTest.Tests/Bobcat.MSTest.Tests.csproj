<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- MSTest's own Microsoft.Testing.Platform host, so this project is a self-executing test
         application like every other *.Tests project here. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>

    <!-- The interceptor opt-in the Bobcat.Generators PACKAGE carries in buildTransitive; a
         ProjectReference analyzer brings the generator but not its props. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Bobcat.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- The hooks the Bobcat.MSTest PACKAGE compiles into a consumer through buildTransitive; a
         ProjectReference does not consume another project's build assets, so in-repo the source
         is included here. -->
    <Compile Include="..\Bobcat.MSTest\buildTransitive\BobcatMSTestHooks.cs" Link="BobcatMSTestHooks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.MSTest\Bobcat.MSTest.csproj" />
    <!-- So marker comments in Specs/BookingSpecs.cs (docs/mstest.md's example) are declared steps. -->
    <ProjectReference Include="..\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
