<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- MSTest's own Microsoft.Testing.Platform host, so this project is a self-executing test
         application like every other *.Tests project here. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- The hooks the Bobcat.MSTest PACKAGE compiles into a consumer through buildTransitive; a
         ProjectReference does not consume another project's build assets, so in-repo the source
         is included here. -->
    <Compile Include="..\Bobcat.MSTest\buildTransitive\BobcatMSTestHooks.cs" Link="BobcatMSTestHooks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.MSTest\Bobcat.MSTest.csproj" />
  </ItemGroup>

</Project>
