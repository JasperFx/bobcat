<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.Supervisor\Bobcat.Supervisor.csproj" />

    <!-- Build ordering only. The projected worker is launched as a process, not linked: an
         ordinary projected xUnit v3 suite, and the worker every end-to-end test drives. -->
    <ProjectReference Include="..\Bobcat.Supervisor.ProjectedWorker\Bobcat.Supervisor.ProjectedWorker.csproj"
                      ReferenceOutputAssembly="false" />

    <!-- Also build ordering only: Bobcat.Tests is an xUnit v3 MTP host, and driving it proves
         the supervisor works against a framework that is not Bobcat. -->
    <ProjectReference Include="..\Bobcat.Tests\Bobcat.Tests.csproj"
                      ReferenceOutputAssembly="false" />

    <!-- Build ordering only, for the issue #394 investigation: a PROJECTED suite driven through
         server mode, which is the only xUnit v3 host in the repository that publishes projected
         scenarios to the monitor wire. -->
    <ProjectReference Include="..\Bobcat.Xunit.Samples\Bobcat.Xunit.Samples.csproj"
                      ReferenceOutputAssembly="false" />

    <!-- The `bobcat` tool, which is how issue #399's projected resident runner ships. Build
         ordering only; ProjectedResidentRunnerTests launches it as an executable. -->
    <ProjectReference Include="..\Bobcat.Console\Bobcat.Console.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectedResidentRunnerTests (moved here from Bobcat.Mtp.Tests, bobcat#471) drives the
         resident runner against the real HTTP stand-in for a console. One source, two
         compilations, so the stand-in's port-binding and double-dispose notes stay in one place. -->
    <Compile Include="..\Bobcat.Tests\Monitoring\FakeMonitorHost.cs"
             Link="Monitoring\FakeMonitorHost.cs" />
  </ItemGroup>

</Project>
