<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Bobcat + Alba integration — IStepContext extensions and an AlbaResource for HTTP/ASP.NET Core integration testing in specs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Alba" />
    <!-- Referenced directly, not only through Bobcat: this project sets
         JasperFxEnvironment.AutoStartHost, and Central Package Management only pins what a
         project actually references (see CLAUDE.md on DispositionKind / Bobcat.Monitor). -->
    <PackageReference Include="JasperFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
  </ItemGroup>

</Project>
