<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <!--
      Issue #405. The importer writes C#, and the one failure a scaffolder must never have is
      output that does not compile — so CSharpModelWriterTests compiles its own output in memory
      with Roslyn, loads it, runs Configure and compares the descriptor to the one
      CuratedModelMapper builds from the same model. Asserting the emitted TEXT alone would pass
      for a file with a missing brace, a shadowed namespace or a generic overload naming a type no
      stub declares, which are exactly the three mistakes the first cut made.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.EventModel\Bobcat.EventModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Issue #110. ProjectedSpecNaming.RoundTrips answers "will this curated scenario name publish
      as itself?", which it can only do by modelling the marker lane's real derivation — and this
      assembly references neither Bobcat nor the generator, so that is a third copy of it.
      ProjectedSpecNamingAgreementTests pins it to the generator's, which Bobcat.Tests already
      pins to the runtime's. A wrong copy makes the round-trip warning report exactly the two
      errors it exists to prevent: silence on a name that drifts, a warning on one that does not.
    -->
    <Compile Include="..\Bobcat.Generators\MarkerSpecNaming.cs" Link="Generators\MarkerSpecNaming.cs" />
  </ItemGroup>

</Project>
