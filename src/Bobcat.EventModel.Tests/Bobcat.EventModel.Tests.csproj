<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat.EventModel\Bobcat.EventModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Issue #324 part 4. Bobcat.Generators is netstandard2.0 and references nothing, so it carries
      its own reader for the spec-ownership manifest rather than shipping YamlDotNet inside an
      analyzer. Linking the source (not the analyzer assembly, which would drag Roslyn in here)
      lets SpecOwnershipParsingAgreementTests compare the two readers directly — the same
      arrangement SliceTagParsingAgreementTests and CodeFirstNamingAgreementTests already use, and
      for the same reason: a silent divergence would put a slice in one lane here and the other
      there, with nothing anywhere reporting it.
    -->
    <Compile Include="..\Bobcat.Generators\SpecOwnershipManifest.cs" Link="Generators\SpecOwnershipManifest.cs" />
    <!--
      Issue #110. ProjectedSpecNaming.RoundTrips answers "will this curated scenario name publish
      as itself?", which it can only do by modelling the marker lane's real derivation — and this
      assembly references neither Bobcat nor the generator, so that is a third copy of it.
      ProjectedSpecNamingAgreementTests pins it to the generator's, which Bobcat.Tests already
      pins to the runtime's. A wrong copy makes the round-trip warning report exactly the two
      errors it exists to prevent: silence on a name that drifts, a warning on one that does not.
    -->
    <Compile Include="..\Bobcat.Generators\MarkerSpecNaming.cs" Link="Generators\MarkerSpecNaming.cs" />
  </ItemGroup>

</Project>
