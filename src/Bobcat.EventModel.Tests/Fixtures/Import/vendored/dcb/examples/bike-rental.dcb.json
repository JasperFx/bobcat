{
  "$schema": "https://dcb.events/schemas/model/v10.json",
  "dcbModelVersion": "10.1",
  "name": "Bike rental",
  "customTypeDefinitions": [
    {
      "name": "BikeId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "MemberId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "BikeStatus",
      "schema": {
        "type": "string",
        "enum": [
          "Unknown",
          "Available",
          "Rented",
          "InRepair"
        ]
      }
    }
  ],
  "eventDefinitions": [
    {
      "name": "BikeAddedToFleet",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "bikeId"
      ]
    },
    {
      "name": "BikeRented",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "bikeId",
        "memberId"
      ]
    },
    {
      "name": "BikeReturned",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "bikeId",
        "memberId"
      ]
    },
    {
      "name": "BikeSentToRepair",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "bikeId"
      ]
    },
    {
      "name": "BikeRepaired",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "bikeId"
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Bike",
      "properties": [
        {
          "name": "status",
          "projection": "BikeStatus"
        }
      ],
      "lifecycle": "status",
      "icon": "\ud83d\udeb2"
    },
    {
      "name": "Member",
      "properties": [
        {
          "name": "activeRentals",
          "projection": "MemberActiveRentals"
        }
      ],
      "icon": "\ud83e\uddd1"
    }
  ],
  "projectionDefinitions": [
    {
      "name": "BikeStatus",
      "tags": [
        {
          "name": "bikeId",
          "tagType": "BikeId"
        }
      ],
      "valueType": "BikeStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "Unknown"
      },
      "handlers": [
        {
          "event": "BikeAddedToFleet",
          "operation": "set",
          "value": {
            "enumMember": "Available"
          }
        },
        {
          "event": "BikeRented",
          "operation": "set",
          "value": {
            "enumMember": "Rented"
          }
        },
        {
          "event": "BikeReturned",
          "operation": "set",
          "value": {
            "enumMember": "Available"
          }
        },
        {
          "event": "BikeSentToRepair",
          "operation": "set",
          "value": {
            "enumMember": "InRepair"
          }
        },
        {
          "event": "BikeRepaired",
          "operation": "set",
          "value": {
            "enumMember": "Available"
          }
        }
      ]
    },
    {
      "name": "MemberActiveRentals",
      "tags": [
        {
          "name": "memberId",
          "tagType": "MemberId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "BikeRented",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "BikeReturned",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "BikeRentedByMember",
      "tags": [
        {
          "name": "bikeId",
          "tagType": "BikeId"
        },
        {
          "name": "memberId",
          "tagType": "MemberId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "BikeRented",
          "operation": "set",
          "value": true
        },
        {
          "event": "BikeReturned",
          "operation": "set",
          "value": false
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "AddBikeToFleet",
      "feature": "Fleet",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "bike",
          "entity": "Bike",
          "id": {
            "parameterName": "bikeId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "bike",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Unknown"
          },
          "rejection": "Bike is already part of the fleet"
        }
      ],
      "publishes": [
        {
          "name": "BikeAddedToFleet",
          "parameters": {
            "bikeId": {
              "parameterName": "bikeId"
            }
          }
        }
      ]
    },
    {
      "name": "SendBikeToRepair",
      "feature": "Fleet",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "bike",
          "entity": "Bike",
          "id": {
            "parameterName": "bikeId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "bike",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Available"
          },
          "rejection": "Bike is not available"
        }
      ],
      "publishes": [
        {
          "name": "BikeSentToRepair",
          "parameters": {
            "bikeId": {
              "parameterName": "bikeId"
            }
          }
        }
      ]
    },
    {
      "name": "RepairBike",
      "feature": "Fleet",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "bike",
          "entity": "Bike",
          "id": {
            "parameterName": "bikeId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "bike",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "InRepair"
          },
          "rejection": "Bike is not in repair"
        }
      ],
      "publishes": [
        {
          "name": "BikeRepaired",
          "parameters": {
            "bikeId": {
              "parameterName": "bikeId"
            }
          }
        }
      ]
    },
    {
      "name": "RentBike",
      "feature": "Rentals",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "bike",
          "entity": "Bike",
          "id": {
            "parameterName": "bikeId"
          }
        },
        {
          "alias": "member",
          "entity": "Member",
          "id": {
            "parameterName": "memberId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "bike",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Available"
          },
          "rejection": "Bike is not available"
        },
        {
          "leftHandSide": {
            "alias": "member",
            "property": "activeRentals"
          },
          "predicate": "lessThan",
          "rightHandSide": 2,
          "rejection": "Member already rents two bikes"
        }
      ],
      "publishes": [
        {
          "name": "BikeRented",
          "parameters": {
            "bikeId": {
              "parameterName": "bikeId"
            },
            "memberId": {
              "parameterName": "memberId"
            }
          }
        }
      ]
    },
    {
      "name": "ReturnBike",
      "feature": "Rentals",
      "properties": [
        {
          "name": "bikeId",
          "propertyType": "BikeId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "damaged",
          "propertyType": "boolean",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "bike",
          "entity": "Bike",
          "id": {
            "parameterName": "bikeId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "bike",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Rented"
          },
          "rejection": "Bike is not rented"
        },
        {
          "leftHandSide": {
            "projection": "BikeRentedByMember",
            "tags": {
              "bikeId": {
                "parameterName": "bikeId"
              },
              "memberId": {
                "parameterName": "memberId"
              }
            }
          },
          "predicate": "isTrue",
          "rejection": "Bike is rented by another member"
        }
      ],
      "publishes": [
        {
          "name": "BikeReturned",
          "parameters": {
            "bikeId": {
              "parameterName": "bikeId"
            },
            "memberId": {
              "parameterName": "memberId"
            }
          }
        },
        {
          "name": "BikeSentToRepair",
          "parameters": {
            "bikeId": {
              "parameterName": "bikeId"
            }
          },
          "when": [
            {
              "leftHandSide": {
                "parameterName": "damaged"
              },
              "predicate": "isTrue"
            }
          ]
        }
      ]
    }
  ],
  "scenarioDefinitions": [
    {
