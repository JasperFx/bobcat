        {
          "event": "BikeRented",
          "data": {
            "bikeId": "b1",
            "memberId": "m1"
          }
        }
      ],
      "when": {
        "arguments": {
          "bikeId": "b1"
        }
      },
      "then": {
        "outcome": "rejected",
