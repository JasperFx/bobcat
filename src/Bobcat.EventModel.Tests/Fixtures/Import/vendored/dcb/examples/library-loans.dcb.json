  "entityDefinitions": [],
  "projectionDefinitions": [
    {
      "name": "CopyInCatalog",
      "tags": [
        {
          "name": "copyId",
          "tagType": "CopyId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "CopyAddedToCatalog",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "CopyBorrowerId",
      "tags": [
        {
          "name": "copyId",
          "tagType": "CopyId"
        }
      ],
      "valueType": "MemberId",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "CopyLent",
          "operation": "set",
          "value": {
            "eventProperty": "memberId"
          }
        },
        {
          "event": "CopyReturned",
          "operation": "set",
          "value": null
        }
      ]
    },
    {
      "name": "MemberLoanCount",
      "tags": [
        {
          "name": "memberId",
          "tagType": "MemberId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "CopyLent",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "CopyReturned",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CopyRenewals",
      "tags": [
        {
          "name": "copyId",
          "tagType": "CopyId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "CopyLent",
          "operation": "set",
          "value": 0
        },
        {
          "event": "LoanRenewed",
          "operation": "increment",
          "value": 1
        }
      ]
    },
    {
      "name": "MemberIsSuspended",
      "tags": [
        {
          "name": "memberId",
          "tagType": "MemberId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "MemberSuspended",
          "operation": "set",
          "value": true
        },
        {
          "event": "MemberReinstated",
          "operation": "set",
          "value": false
        }
      ]
    },
    {
      "name": "CopyBookId",
      "tags": [
        {
          "name": "copyId",
          "tagType": "CopyId"
        }
      ],
      "valueType": "BookId",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "CopyAddedToCatalog",
          "operation": "set",
          "value": {
            "eventProperty": "bookId"
          }
        }
      ]
    },
    {
      "name": "BookReservations",
      "tags": [
        {
          "name": "bookId",
          "tagType": "BookId"
        }
      ],
      "valueType": "MemberId",
      "isList": true,
      "initialValue": [],
      "handlers": [
        {
          "event": "BookReserved",
          "operation": "append",
          "value": {
            "eventProperty": "memberId"
          }
        },
        {
          "event": "ReservationCancelled",
          "operation": "remove",
          "value": {
            "eventProperty": "memberId"
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "AddCopyToCatalog",
      "feature": "Catalog",
      "properties": [
        {
          "name": "copyId",
          "propertyType": "CopyId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "bookId",
          "propertyType": "BookId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "CopyInCatalog",
            "tags": {
              "copyId": {
                "parameterName": "copyId"
              }
            }
          },
          "predicate": "isFalse",
          "rejection": "Copy is already in the catalog"
        }
      ],
      "publishes": [
        {
          "name": "CopyAddedToCatalog",
          "parameters": {
            "copyId": {
              "parameterName": "copyId"
            },
            "bookId": {
              "parameterName": "bookId"
            }
          }
        }
      ]
    },
    {
      "name": "LendCopy",
      "feature": "Loans",
      "properties": [
        {
          "name": "copyId",
          "propertyType": "CopyId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "CopyInCatalog",
            "tags": {
              "copyId": {
                "parameterName": "copyId"
              }
            }
          },
          "predicate": "isTrue",
          "rejection": "Copy is not in the catalog"
        },
        {
          "leftHandSide": {
            "projection": "CopyBorrowerId",
            "tags": {
              "copyId": {
                "parameterName": "copyId"
              }
            }
          },
          "predicate": "isEmpty",
          "rejection": "Copy is not available"
        },
        {
          "leftHandSide": {
            "projection": "MemberLoanCount",
            "tags": {
              "memberId": {
                "parameterName": "memberId"
              }
            }
          },
          "predicate": "lessThan",
          "rightHandSide": 3,
          "rejection": "Member already borrows three copies"
        }
      ],
      "publishes": [
        {
          "name": "CopyLent",
          "parameters": {
            "copyId": {
              "parameterName": "copyId"
            },
            "memberId": {
              "parameterName": "memberId"
            }
          }
        }
      ]
    },
    {
      "name": "ReturnCopy",
      "feature": "Loans",
      "properties": [
        {
          "name": "copyId",
          "propertyType": "CopyId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "CopyBorrowerId",
            "tags": {
              "copyId": {
                "parameterName": "copyId"
              }
            }
          },
          "predicate": "isNotEmpty",
          "rejection": "Copy is not lent"
        },
        {
          "leftHandSide": {
            "projection": "CopyBorrowerId",
            "tags": {
              "copyId": {
                "parameterName": "copyId"
              }
            }
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "memberId"
          },
          "rejection": "Copy is lent to another member"
        }
      ],
      "publishes": [
        {
          "name": "CopyReturned",
          "parameters": {
            "copyId": {
              "parameterName": "copyId"
            },
            "memberId": {
              "parameterName": "memberId"
            }
          }
        }
      ]
    },
    {
      "name": "RenewLoan",
      "feature": "Loans",
      "properties": [
        {
          "name": "copyId",
          "propertyType": "CopyId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "borrowerId",
          "projection": "CopyBorrowerId",
          "tags": {
            "copyId": {
              "parameterName": "copyId"
            }
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "borrowerId"
          },
          "predicate": "isNotEmpty",
          "rejection": "Copy is not lent"
        },
        {
          "leftHandSide": {
            "projection": "CopyRenewals",
            "tags": {
              "copyId": {
                "parameterName": "copyId"
              }
            }
          },
          "predicate": "lessThan",
          "rightHandSide": 2,
          "rejection": "Loan was already renewed twice"
        },
        {
          "leftHandSide": {
            "projection": "MemberIsSuspended",
            "tags": {
              "memberId": {
                "alias": "borrowerId"
              }
            }
          },
          "predicate": "isFalse",
          "rejection": "Borrower is suspended"
        },
        {
          "leftHandSide": {
            "projection": "BookReservations",
            "tags": {
              "bookId": {
                "projection": "CopyBookId",
                "tags": {
                  "copyId": {
                    "parameterName": "copyId"
                  }
                }
              }
            }
          },
          "predicate": "isEmpty",
          "rejection": "Book is reserved"
        }
      ],
      "publishes": [
        {
          "name": "LoanRenewed",
          "parameters": {
            "copyId": {
              "parameterName": "copyId"
            }
          }
        }
      ]
    },
    {
      "name": "SuspendMember",
      "feature": "Members",
      "properties": [
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "MemberIsSuspended",
            "tags": {
              "memberId": {
                "parameterName": "memberId"
              }
            }
          },
          "predicate": "isFalse",
          "rejection": "Member is already suspended"
        }
      ],
      "publishes": [
        {
          "name": "MemberSuspended",
          "parameters": {
            "memberId": {
              "parameterName": "memberId"
            }
          }
        }
      ]
    },
    {
      "name": "ReinstateMember",
      "feature": "Members",
      "properties": [
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "MemberIsSuspended",
            "tags": {
              "memberId": {
                "parameterName": "memberId"
              }
            }
          },
          "predicate": "isTrue",
          "rejection": "Member is not suspended"
        }
      ],
      "publishes": [
        {
          "name": "MemberReinstated",
          "parameters": {
            "memberId": {
              "parameterName": "memberId"
            }
          }
        }
      ]
    },
    {
      "name": "ReserveBook",
      "feature": "Reservations",
      "properties": [
        {
          "name": "bookId",
          "propertyType": "BookId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "BookReservations",
            "tags": {
              "bookId": {
                "parameterName": "bookId"
              }
            }
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "memberId"
          },
          "negate": true,
          "rejection": "Member already reserved the book"
        }
      ],
      "publishes": [
        {
          "name": "BookReserved",
          "parameters": {
            "bookId": {
              "parameterName": "bookId"
            },
            "memberId": {
              "parameterName": "memberId"
            }
          }
        }
      ]
    },
    {
      "name": "CancelReservation",
      "feature": "Reservations",
      "properties": [
        {
          "name": "bookId",
          "propertyType": "BookId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "memberId",
          "propertyType": "MemberId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "BookReservations",
            "tags": {
              "bookId": {
                "parameterName": "bookId"
              }
            }
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "memberId"
          },
          "rejection": "Member has not reserved the book"
        }
      ],
      "publishes": [
        {
          "name": "ReservationCancelled",
          "parameters": {
            "bookId": {
              "parameterName": "bookId"
            },
            "memberId": {
              "parameterName": "memberId"
            }
          }
        }
      ]
    }
  ],
