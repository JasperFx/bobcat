      "name": "Renew a loan",
      "command": "RenewLoan",
      "given": [
        {
          "event": "CopyAddedToCatalog",
          "data": {
            "copyId": "c1",
            "bookId": "b1"
          }
        },
        {
          "event": "CopyLent",
