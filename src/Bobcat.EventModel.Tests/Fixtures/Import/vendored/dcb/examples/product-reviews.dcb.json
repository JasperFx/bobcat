    {
      "id": "02bf8d3a-4b30-41fe-934e-936659e6f5ad",
      "name": "Delist a product twice",
      "command": "DelistProduct",
      "given": [
        {
          "event": "ProductDelisted",
          "data": {
            "productId": "p1"
          }
        }
      ],
      "when": {
        "arguments": {
          "productId": "p1"
        }
