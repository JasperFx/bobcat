      "then": {
        "outcome": "published",
        "events": [
          {
            "type": "ProductReviewed",
            "data": {
              "productId": "p1",
              "customerId": "c1",
              "rating": 5
            }
          }
        ]
      }
    },
    {
      "id": "1d9b278c-5ec9-4553-adbf-70dae34356af",
