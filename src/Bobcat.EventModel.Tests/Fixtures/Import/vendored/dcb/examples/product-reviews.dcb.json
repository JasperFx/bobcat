        }
      ],
      "when": {
        "arguments": {
          "productId": "p1",
          "customerId": "c1",
          "rating": 5
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "rejection": "Only customers who bought the product can review it"
      }
    },
    {
