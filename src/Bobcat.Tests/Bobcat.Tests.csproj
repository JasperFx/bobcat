<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobcat\Bobcat.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!--
      Issue #106. Bobcat.Generators is netstandard2.0 and references nothing, so it carries its own
      copy of the slice-tag parsing that Bobcat.Runtime.SliceTags owns. Linking the source (rather
      than referencing the analyzer assembly, which would drag Roslyn in here) lets
      SliceTagParsingAgreementTests compare the two implementations directly. Same reason
      ResourceParsingAgreementTests exists for the recovery-hint resource lists.
    -->
    <Compile Include="..\Bobcat.Generators\GeneratorSliceTags.cs" Link="Runtime\GeneratorSliceTags.cs" />
    <!-- Same deal for the code-first naming rules (issue #170): the generator stamps a spec's
      {Feature}/{Scenario} identity from its own copy of SpecificationFeature's derivations, and
      CodeFirstNamingAgreementTests pins the two together — a divergence would silently unjoin
      run evidence from the design-time model. -->
    <Compile Include="..\Bobcat.Generators\CodeFirstNaming.cs" Link="Runtime\CodeFirstNaming.cs" />
  </ItemGroup>

</Project>
