<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10 to match the Bobcat libraries the Tests project links against. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match Tests.csproj's AssemblyName, not its directory name. -->
    <InternalsVisibleTo Include="EcommerceModularMonolith.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.FluentValidation" Version="6.24.2" />
    <PackageReference Include="WolverineFx.Http" Version="6.24.2" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.24.2" />
    <PackageReference Include="WolverineFx.Marten" Version="6.24.2" />
    <!-- Wolverine 6 stopped shipping the runtime compiler in core, so a host left in the default
         TypeLoadMode.Dynamic fails to START with "no IAssemblyGenerator (Roslyn) is registered"
         (GH-2876). See docs/sample-wiring.md footgun 4. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.24.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <!-- The spec fixture is compiled by Tests.csproj, which references Bobcat. Leaving it in the
         host's compile group is what made this project 158 undefined symbols. -->
    <Compile Remove="EcommerceModularMonolithFixture.cs" />
  </ItemGroup>

</Project>
