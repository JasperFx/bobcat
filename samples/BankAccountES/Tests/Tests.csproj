<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Match the InternalsVisibleTo declared in BankAccountES.csproj. -->
    <AssemblyName>BankAccountES.Tests</AssemblyName>
    <RootNamespace>BankAccountES.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BankAccountES.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat\Bobcat.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat.Alba\Bobcat.Alba.csproj" />
    <!-- Store-agnostic event-store helpers (reset, projection waits). Deliberately NOT Bobcat.Marten:
         the spec project talks to the host's store through JasperFx.Events.IEventStore, so it would
         read the same against Polecat or Fisher. See CLAUDE.md, "Bobcat.CritterStack is store-agnostic". -->
    <ProjectReference Include="..\..\..\src\Bobcat.CritterStack\Bobcat.CritterStack.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\Features\**\*.feature" />
  </ItemGroup>

  <!-- Include the fixture from the parent project directory, which excludes it from its own
       compilation. The host has no reference to Bobcat, so a fixture compiled there is 61
       undefined symbols. -->
  <ItemGroup>
    <Compile Include="..\BankAccountESFixture.cs" />
  </ItemGroup>

</Project>
