<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- bobcat#172 fourth rung: the repo-local CritterWatch client at 1.0.2-vehicle.1 — the
         published 1.0.1 predates EventModelDiscovery in ManifestAggregator, so its event-model
         manifest push carries zero slices. Remove this source when CritterWatch 1.0.2+ ships. -->
    <add key="bobcat-local" value="../../artifacts/local-feed" />
  </packageSources>
  <packageSourceMapping>
    <!-- Wolverine.CritterWatch ONLY. The Bobcat* pattern that used to sit here was stale — the
         sample takes Bobcat by ProjectReference, never as a package — and once Bobcat published
         0.9.0 to nuget.org it became the same shadowing hazard as the machine-level mapping
         removed on 2026-08-31: a folder-feed pack and a release sharing one version number are
         indistinguishable in a props file. -->
    <packageSource key="bobcat-local">
      <package pattern="Wolverine.CritterWatch" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
