<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10 to match the Bobcat libraries the Tests project links against. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match Tests.csproj's AssemblyName, not its directory name. -->
    <InternalsVisibleTo Include="BankAccountES.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
    <!-- The spec fixture is compiled by Tests.csproj, which references Bobcat. Leaving it in the
         host's compile group is what made this project 61 undefined symbols. -->
    <Compile Remove="BankAccountESFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.FluentValidation" Version="6.35.0" />
    <PackageReference Include="WolverineFx.Http" Version="6.35.0" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.35.0" />
    <!-- Both stores are referenced; Program.cs registers ONE of them from configuration (EventStore=Marten|Fisher).
         Every handler and projection is written against the store-agnostic vocabulary, so neither package
         is named outside Program.cs. Issue #103. -->
    <PackageReference Include="WolverineFx.Marten" Version="6.35.0" />
    <PackageReference Include="WolverineFx.Fisher" Version="6.35.0" />
    <!-- The stores are pinned EXPLICITLY rather than left to Wolverine's floors. This project
         reaches Bobcat by ProjectReference, so it resolves Bobcat's JasperFx.Events (2.67.1),
         while WolverineFx.Marten/Fisher only floor the stores at 9.32.1 / 1.2.0. A store older
         than the JasperFx it runs against fails to LOAD — JasperFx.Events 2.67 added an
         abstract `QueryStreamStates` to IReadOnlyEventStore — which is how this sample's Fisher
         leg died with a TypeLoadException while every pin looked satisfiable. Keep these in
         step with src/Directory.Packages.props; the long version of the rule is in its header. -->
    <PackageReference Include="Marten" Version="9.33.0" />
    <PackageReference Include="Fisher" Version="1.3.0" />
    <!-- Marten and Fisher each bundle JasperFx.Events.SourceGenerator inside their own nupkg, so
         referencing both loads the generator twice and every aggregate's Evolver partial is
         emitted twice (CS0433 — jasperfx#462). Compile with one explicit copy, pinned to the same
         JasperFx.Events the Tests project unifies on, and drop every store-bundled copy below.
         Same fix as src/Bobcat.CritterStack.Tests, which references both stores for the same
         reason. Two identical store-bundled generators used to dedupe by themselves, which is why
         this only became visible when the stores moved to different JasperFx builds. -->
    <PackageReference Include="JasperFx.Events" Version="2.67.1" />
    <PackageReference Include="JasperFx.Events.SourceGenerator" Version="2.67.1"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Wolverine 6 stopped shipping the runtime compiler in core, so a host left in the default
         TypeLoadMode.Dynamic fails to START with "no IAssemblyGenerator (Roslyn) is registered"
         (GH-2876). See docs/sample-wiring.md footgun 4. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.35.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <!-- bobcat#172 fourth rung: CritterWatch monitoring, config-gated in Program.cs so specs and
         CI run exactly as before. The client floors WolverineFx at 6.31.0; the pins here sit above it, matched to
         src/Directory.Packages.props. -->
    <PackageReference Include="Wolverine.CritterWatch" Version="1.0.2-vehicle.1" />
    <PackageReference Include="WolverineFx.RabbitMQ" Version="6.35.0" />
  </ItemGroup>

  <Target Name="DropDuplicateBundledEventSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'JasperFx.Events.SourceGenerator' and ($([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/marten/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/fisher/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/polecat/')))" />
    </ItemGroup>
  </Target>

</Project>
