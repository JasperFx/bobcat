<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OutboxDemo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
    <!-- The spec fixture is compiled by Tests.csproj, which references Bobcat. Leaving it here
         is what made this project ~46 undefined symbols: the host has no such reference. -->
    <Compile Remove="OutboxDemoFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.Http" Version="6.29.1" />
    <!-- Wolverine 6 stopped shipping the runtime compiler in core, so a host left in the default
         TypeLoadMode.Dynamic now fails to START: "no IAssemblyGenerator (Roslyn) is registered"
         (GH-2876). Referencing this package auto-registers one. A build-only CI job could never
         have caught that — it took running the specs. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.29.1" />
    <PackageReference Include="WolverineFx.Marten" Version="6.29.1" />
    <PackageReference Include="WolverineFx.RabbitMQ" Version="6.29.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
