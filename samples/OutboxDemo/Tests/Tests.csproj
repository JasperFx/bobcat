<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The OutboxDemo specifications, in Bobcat's projected (code-first) model on xUnit v3
    (bobcat#471). Ordinary tests that render as Given/When/Then specifications; the HTTP calls go
    through Alba directly.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Match the InternalsVisibleTo declared in the host project. -->
    <AssemblyName>OutboxDemo.Tests</AssemblyName>
    <RootNamespace>OutboxDemo.Tests</RootNamespace>

    <!-- The interceptor opt-in the Bobcat.Generators PACKAGE carries in buildTransitive; a
         ProjectReference analyzer brings the generator but not its props. Without it a [Given] /
         [When] / [Then] helper is an ordinary method call and records nothing, and a SpecAssert
         inside it reports to no step, so the spec would pass vacuously. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Bobcat.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform-extension registration the Bobcat.Xunit PACKAGE carries in buildTransitive; a
         ProjectReference does not consume another project's build assets, so it is stated here. -->
    <TestingPlatformBuilderHook Include="0A1C4D7E-3B52-4F8A-9C61-7D2E8B4A5F30">
      <DisplayName>Bobcat.Xunit</DisplayName>
      <TypeFullName>Bobcat.Xunit.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Alba" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutboxDemo.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat\Bobcat.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat.Xunit\Bobcat.Xunit.csproj" />
    <ProjectReference Include="..\..\..\src\Bobcat.Generators\Bobcat.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
