<Project>

  <!--
    Shared build settings for samples/.

    The nine sample spec projects are Microsoft.Testing.Platform test hosts — `dotnet test` and an
    IDE's Test Explorer see one scenario as one test node. That is what docs/integrating-gherkin.md
    tells a reader to pick, and the samples are what a reader copies, so they take that path too.

    Every one of them used to declare its own Main and go through BobcatRunner.Run instead. That is
    a supported surface (it is what carries `preview` and `interactive`), but it is the minority
    one, and it made each sample pay for a footgun it never needed: a Tests project with its own
    entry point collides with the `Program` its referenced web app synthesizes from top-level
    statements, which surfaces as a native PAL crash with no managed stack. Every SpecsRunner.cs
    carried a paragraph explaining that. As MTP hosts they declare no entry point at all, the
    generator emits one, and the collision cannot arise.

    Applied only to the spec projects. The sample web apps beside them are ordinary executables.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Tests'">
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!--
      A package consumer inherits this from Bobcat.Mtp's buildTransitive props; a ProjectReference
      does not consume build assets, so in-repo it is set by hand. The Bobcat-generated entry point
      replaces the platform's synthesized one.
    -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

</Project>
