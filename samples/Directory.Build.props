<Project>

  <!--
    Shared build settings for samples/.

    Every sample spec project is an xUnit v3 test host on Microsoft.Testing.Platform, written in
    Bobcat's projected (code-first) model (bobcat#471) -- `dotnet test` and an IDE's Test Explorer
    see one spec as one test node. There are no .feature files and no Bobcat-generated entry point
    any more: xUnit v3 generates its own, so the platform's synthesized one is turned off below.

    A test project with its own Main used to collide with the `Program` its referenced web app
    synthesizes from top-level statements, which surfaced as a native PAL crash with no managed
    stack. With exactly one generated entry point that collision cannot arise.

    Applied only to the spec projects. The sample web apps beside them are ordinary executables.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Tests'">
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- xUnit v3 generates the entry point; the platform's synthesized one would be a second. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

</Project>
