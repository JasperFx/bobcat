<Project>

  <!--
    Shared build settings for samples/.

    Every sample spec project is an xUnit v3 test host on Microsoft.Testing.Platform, written in
    Bobcat's projected (code-first) model (bobcat#471), so `dotnet test` and an IDE's Test Explorer
    see one spec as one test node. There are no .feature files and no Bobcat-generated entry point
    any more: xUnit v3 generates its own, so the platform's synthesized one is turned off below.

    A test project with its own Main used to collide with the `Program` its referenced web app
    synthesizes from top-level statements, which surfaced as a native PAL crash with no managed
    stack. With exactly one generated entry point that collision cannot arise.

    Applied only to the spec projects. The sample web apps beside them are ordinary executables.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Tests'">
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- xUnit v3 generates the entry point; the platform's synthesized one would be a second. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <!--
    What a spec project would get from the Bobcat.Generators and Bobcat.Xunit PACKAGES' buildTransitive
    props, imported from the very same files (bobcat#484). The samples reference Bobcat by
    ProjectReference, and a ProjectReference takes no build assets: the analyzer reference brings the
    generator, but not the InterceptorsNamespaces opt-in for Bobcat.Generated (BOBCAT037 without it), and
    Bobcat.Xunit brings the assembly, but not its TestingPlatformBuilderHook item. Every Tests.csproj used
    to restate both by hand, which is a copy that can drift from the package and a line a new sample can
    forget. Importing the package's own props means a sample is configured exactly like a consumer.

    Props only, not Bobcat.Generators.targets: its BOBCAT033 check is about Rider and Visual Studio
    discovery, which the samples do not claim.
  -->
  <Import Condition="'$(MSBuildProjectName)' == 'Tests'"
          Project="$(MSBuildThisFileDirectory)../src/Bobcat.Generators/buildTransitive/Bobcat.Generators.props" />
  <Import Condition="'$(MSBuildProjectName)' == 'Tests'"
          Project="$(MSBuildThisFileDirectory)../src/Bobcat.Xunit/buildTransitive/Bobcat.Xunit.props" />

</Project>
