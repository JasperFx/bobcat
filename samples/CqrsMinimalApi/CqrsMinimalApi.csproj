<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Bumped to net10 to match the Bobcat libraries (Bobcat, Bobcat.Alba)
         which are net10-only. Targeting net9 here causes Alba.For<Program>
         to fail with a native PAL crash on host bootstrap. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CqrsMinimalApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Compile Remove="CqrsMinimalApiFixture.cs" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.Http" Version="6.24.2" />
    <PackageReference Include="WolverineFx.Marten" Version="6.24.2" />
    <!-- Wolverine 6 stopped shipping the runtime compiler in core, so this host could not START
         even though it compiled (GH-2876). See docs/sample-wiring.md footgun 4. That the
         *reference* sample had this is the argument for the playbook's "run it" step. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.24.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
