<Project>

  <!--
    Central Package Management for samples/.

    The samples are outside bobcat.slnx, so nothing forced them onto one version set and they
    drifted into two generations: half on WolverineFx 6.29.1 / Marten 9.28.0, half on 6.38.0 /
    9.36.0. That is not cosmetic. A sample project-references Bobcat, which pinned
    JasperFx.Events 2.69.3 at the time, and Marten 9.28 was compiled before 2.67 made `QueryStreamStates`
    an ABSTRACT member of IReadOnlyEventStore — so the older samples loaded fine, built fine,
    and died the first time anything opened a session:

      System.TypeLoadException: Method 'QueryStreamStates' in type
      'Marten.Events.QueryEventStore' ... does not have an implementation.

    This is the same failure src/Directory.Packages.props documents at length; read its header
    before changing any version here. Nothing caught it because samples.yml only BUILDS the
    samples — a floor constrains resolution, not the vtable.

    The Critter Stack versions below must stay identical to src/Directory.Packages.props. The
    property that matters is that every package in a sample resolves the SAME JasperFx.Events
    as the Bobcat it references, and the only safe signal is that each store was BUILT against
    that JasperFx.

    ⚠️ JasperFx.Events is at 2.85.0 while the stores here are built against older JasperFx. That is
    the same deliberate, documented exception src/Directory.Packages.props carries, not drift. Read
    "THE 2.81.0 EXCEPTION" there (moved to 2.85.0 on 2026-10-12) before changing either number. The
    samples project-reference Bobcat, which compiles against 2.85.0, so a lower pin here is a
    downgrade the moment a sample references it.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Critter Stack — must match src/Directory.Packages.props exactly -->
    <PackageVersion Include="WolverineFx.Http" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.Http.Marten" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.Http.FluentValidation" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.Fisher" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.46.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.46.0" />
    <PackageVersion Include="Marten" Version="9.46.0" />
    <PackageVersion Include="Marten.AspNetCore" Version="9.46.0" />
    <PackageVersion Include="Fisher" Version="1.19.0" />
    <PackageVersion Include="JasperFx.Events" Version="2.85.0" />
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="2.85.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Alba directly: Bobcat ships no Alba integration, so each sample hosts its own. -->
    <PackageVersion Include="Alba" Version="8.5.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Projected (code-first) specs: every sample's Tests project runs on xUnit v3 through
         Bobcat.Xunit (bobcat#471). Same versions as src/Directory.Packages.props. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample-only -->
    <PackageVersion Include="Wolverine.CritterWatch" Version="1.0.2-vehicle.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.8.1" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="9.2.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="9.2.1" />
    <PackageVersion Include="Aspire.Npgsql" Version="9.2.1" />
  </ItemGroup>

</Project>
